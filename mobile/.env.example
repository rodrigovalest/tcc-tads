# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_API_URL=ws://localhost:3000

# TURN Server Configuration
EXPO_PUBLIC_TURN_SERVER_URL=turn:localhost:3478
EXPO_PUBLIC_TURN_SERVER_USERNAME=webrtcuser
EXPO_PUBLIC_TURN_SERVER_PORT=3478

# Google OAuth Configuration
# Get these from Google Cloud Console -> APIs & Services -> Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_APP_SCHEME=com.tcc.mobile